{
  "name": "marktext-monorepo",
  "version": "0.24.0-dev",
  "description": "MarkText monorepo root",
  "private": true,
  "homepage": "https://github.com/marktext/marktext",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "postinstall": "tsx scripts/postinstall.ts",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "minify-locales": "tsx scripts/minify-locales.ts",
    "rebuild-native": "pnpm --filter marktext rebuild-native",
    "start": "pnpm --filter marktext start",
    "dev": "pnpm --filter marktext dev",
    "build": "pnpm --filter marktext build",
    "build:unpack": "pnpm --filter marktext build:unpack",
    "build:win": "pnpm --filter marktext build:win",
    "build:win:x64": "pnpm --filter marktext build:win:x64",
    "build:win:arm64": "pnpm --filter marktext build:win:arm64",
    "build:mac": "pnpm --filter marktext build:mac",
    "build:mac:x64": "pnpm --filter marktext build:mac:x64",
    "build:mac:arm64": "pnpm --filter marktext build:mac:arm64",
    "build:linux": "pnpm --filter marktext build:linux",
    "build:linux:x64": "pnpm --filter marktext build:linux:x64",
    "build:linux:arm64": "pnpm --filter marktext build:linux:arm64",
    "perf:inspect": "pnpm --filter marktext perf:inspect",
    "perf:inspect-brk": "pnpm --filter marktext perf:inspect-brk",
    "test": "pnpm --filter marktext test",
    "test:unit": "pnpm --filter marktext test:unit",
    "test:e2e": "pnpm --filter marktext test:e2e",
    "typecheck": "pnpm --filter marktext typecheck",
    "typecheck:watch": "pnpm --filter marktext typecheck:watch",
    "check": "pnpm lint && pnpm typecheck",
    "gen-third-party": "tsx scripts/generateThirdPartyLicense.ts",
    "validate-licenses": "tsx scripts/validateLicenses.ts",
    "migration:build-wasm": "cargo build --manifest-path rust/Cargo.toml -p marktext-wasm-host --target wasm32-unknown-unknown --release && wasm-bindgen --target web --out-dir packages/desktop/src/renderer/public/gpui-host --out-name marktext-wasm-host \"${CARGO_TARGET_DIR:-rust/target}/wasm32-unknown-unknown/release/marktext-wasm-host.wasm\"",
    "migration:build-native-pref": "cargo build --manifest-path rust/Cargo.toml -p mt-pref-app --release",
    "migration:progress": "node --no-warnings scripts/migration-progress.ts",
    "migration:measure": "node --no-warnings scripts/migration-measure.ts",
    "migration:qa-monitor": "node --no-warnings scripts/qa-monitor/run-qa-monitor.ts",
    "migration:qa-test": "node --no-warnings --test scripts/qa-monitor/qa-monitor.test.ts",
    "migration:triage": "node --no-warnings scripts/issue-triage/run-triage.ts",
    "migration:triage-test": "node --no-warnings --test scripts/issue-triage/triage.test.ts",
    "migration:legacy-sync": "node --no-warnings scripts/legacy-sync/run-legacy-sync.ts",
    "migration:legacy-sync-test": "node --no-warnings --test scripts/legacy-sync/legacy-sync.test.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/desktop/src/**/*.{ts,vue}": [
      "eslint --fix"
    ],
    "packages/desktop/test/**/*.ts": [
      "eslint --fix"
    ],
    "*.{json,md,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.7",
    "@cursor/sdk": "^1.4.2",
    "@eslint/js": "^10.0.1",
    "electron": "~45.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-html": "^8.2.1",
    "eslint-plugin-i18n-json": "^4.0.1",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-vue": "^10.12.0",
    "husky": "^9.1.7",
    "license-checker": "^25.0.1",
    "lint-staged": "^17.6.0",
    "neostandard": "^0.14.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vue-eslint-parser": "^10.4.1"
  }
}
